# =====================================================
# FUNNEL SWIPER DASHBOARD — ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =====================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Security (SOC 2) ---
# Secret used to authenticate internal API calls and dashboard access.
# Generate with: openssl rand -hex 32
DASHBOARD_API_SECRET=

# Comma-separated list of allowed CORS origins (production URLs)
ALLOWED_ORIGINS=https://your-dashboard.vercel.app,https://your-domain.com

# --- AI API Keys ---
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=

# --- External Services ---
AGENTIC_BROWSER_API_URL=http://localhost:8000
CHECKOUT_CHAMP_LOGIN_ID=
CHECKOUT_CHAMP_PASSWORD=

# --- OpenClaw Worker (locale) ---
# Base URL del deploy Netlify a cui openclaw-worker.js deve parlare
# (sia per fetchare i job pending che per gli endpoint /api/swipe/*).
# Se non settata, usa il default https://cute-cupcake-74bad8.netlify.app
TOOL_BASE_URL=https://cute-cupcake-74bad8.netlify.app

# --- MCP Server ---
# Fallback API key usata da bundle-mcp quando il client non manda
# X-API-Key. Va settata su Netlify (NON in .env.local committato).
# Genera una key con prefisso "fsk_" e mettila qui:
MCP_DEFAULT_API_KEY=

# --- Build ---
# Set to 'true' only for Docker/Fly.io self-hosting
STANDALONE=false

# --- Ads Creative intel (Jev integration) ---
# Local autonomy: jobs run in-process with npm run dev (default when NODE_ENV!=production)
ADS_INTEL_INLINE=1
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
JUDGE_ENGINE=jev
IMAGE_MODEL=openai/gpt-image-2
WRITER_MODEL=anthropic/claude-sonnet-4
VISION_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=baai/bge-m3
IMAGE_EMBEDDING_MODEL=voyage/voyage-multimodal-3
ADS_INTEL_SKIP_ASSETS=0
# Optional Meta spike (before OAuth UI)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_TOKEN_ENCRYPTION_KEY=

# Claude Cloud reel engine (shared host)
# REEL_ENGINE_URL=https://reel-engine.example
# REEL_ENGINE_SECRET=
