# ============================================================================
# Reel Engine — configurazione ambiente
# Copia questo file in .env e compila le chiavi. Ogni collaboratore usa le
# PROPRIE chiavi API (mai condividere le chiavi in chat/repo).
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------

# fal.ai — genera i video delle scene (Kling 3.0 Pro) + lip-sync
# Chiave: https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs — genera il voiceover con word timestamps
# Chiave: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice ID di default (override per-script con il campo voiceId nello script.json)
ELEVENLABS_VOICE_ID=

# Google AI (Gemini) — Stage 1.7 Storyboard (keyframe) + Gemini Vision (audit scene-map)
# Chiave: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- OPTIONAL: percorsi e runtime --------------------------------------------

# Cartella base degli output. Default: ~/Movies/reel-ai
# Wasabi multi-project: ogni ProjectHub id ha REEL_OUTPUT_BASE/<projectId>/
#   footage/cleaned  — competitor shots importati da Supabase
#   ai-clips/        — b-roll generati (reel_generate_clip MCP)
# REEL_OUTPUT_BASE=

# --- Wasabi ProjectHub (import footage + MCP) --------------------------------

# Stesse credenziali del tool-wasabi (service role per download storage)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Binario whisper per `pnpm refresh:deconstruct` (trascrizione ad originali).
# Default: "whisper" risolto dal PATH (pip install openai-whisper).
# Esempio macOS Python.org: /Library/Frameworks/Python.framework/Versions/3.13/bin/whisper
# WHISPER_BIN=

# Numero di scene generate in parallelo nello Stage 2. Default: 3
# REEL_SCENE_CONCURRENCY=3

# --- OPTIONAL: modelli Gemini (default validati 2026-05-27) -------------------

# Override modello image-gen storyboard (default: gemini-3-pro-image-preview)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Override modello vision audit (default: gemini-3.1-pro-preview)
# GEMINI_VISION_MODEL=gemini-3.1-flash
# Reference d'immagine "style anchor" passata a ogni keyframe (path o URL)
# GEMINI_IMAGE_STYLE_ANCHOR=

# --- OPTIONAL: Veo 3 (scene provider="veo3" / audioMode veo-native) ----------

# Backend: "gemini" (default, API key sopra, modelli PREVIEW con rate limit RPD)
# oppure "vertex" (GA, richiede progetto GCP + gcloud CLI installato)
# VEO_BACKEND=gemini
# VEO_GEMINI_MODEL=veo-3.1-generate-preview
# VEO_GEMINI_RESOLUTION=720p
# VEO_POLL_INTERVAL_MS=60000
# Solo per backend vertex:
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# VEO_VERTEX_MODEL=
# VEO_OUTPUT_GCS_URI=
# Override modelli Veo via fal.ai (path alternativo):
# VEO_MODEL=
# VEO_I2V_MODEL=

# --- OPTIONAL: HeyGen (scene provider="heygen", avatar talking-head) ----------

# HEYGEN_API_KEY=
# HEYGEN_DEFAULT_AVATAR_ID=

# --- OPTIONAL: Remotion Lambda (rendering cloud, non usato di default) --------

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# REMOTION_AWS_REGION=eu-central-1

# --- DEPRECATED: Higgsfield MCP (disabilitato 2026-05-28) ---------------------
# Costo ~$25-30/reel vs ~$5-7 con fal.ai Kling, qualità inferiore.
# Tenuto solo per backward compat con reel storici (videoEngine seedance/kling-hf).
# HIGGSFIELD_MAX_CONCURRENT=6
# HIGGSFIELD_JOB_TIMEOUT_MIN=8
# HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp


# --- Claude Cloud host (shared reel engine) ---------------------------------
# Layout: REEL_OUTPUT_BASE/<mediaBuyer>/<projectId>/...
# Wasabi Netlify must set the same REEL_ENGINE_URL + REEL_ENGINE_SECRET.

# Shared secret between Wasabi and this host (Bearer token)
# REEL_ENGINE_SECRET=change-me-long-random

# HTTP listen port (default 8787). Expose via tunnel/VPN to Netlify.
# REEL_ENGINE_PORT=8787

# Auto-invoke Claude Code CLI for produce jobs (1) or only write prompt files (0)
# REEL_AUTO_CLAUDE=1
# REEL_CLAUDE_BIN=claude
