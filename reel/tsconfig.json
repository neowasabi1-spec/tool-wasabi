{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@remotion/*": ["./remotion/*"],
      "@services/*": ["./src/services/*"],
      "@schemas/*": ["./src/schemas/*"]
    }
  },
  "include": ["remotion/**/*", "src/**/*", "scripts/**/*", "mcp/**/*"],
  "exclude": ["node_modules", "dist", "output", "scripts/archive"]
}
