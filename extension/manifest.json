{
  "manifest_version": 3,
  "name": "Wasabi Saver",
  "version": "1.8.1",
  "description": "Save landing pages and bulk-import AdSpends ads into Template → Ads (auto Image/Video/Story/UGC), plus hover-save creatives into a project's Competitor Library.",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "debugger", "downloads", "declarativeNetRequest", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save this page to Wasabi",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject-sniffer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content-session-sync.js", "content-creative.js"],
      "run_at": "document_idle"
    }
  ]
}
